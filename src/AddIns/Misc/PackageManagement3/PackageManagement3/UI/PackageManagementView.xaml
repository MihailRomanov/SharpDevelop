<UserControl x:Class="PackageManagement.UI.PackageManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pm="clr-namespace:PackageManagement.UI">
	<DockPanel Margin="5">
		<Grid DockPanel.Dock="Top">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" >
				<Label FontSize="16" Target="{Binding ElementName=PackageSources}">Package source:</Label>
				<ComboBox Width="200" x:Name="PackageSources">
					<ComboBox.ItemTemplate>
						<DataTemplate DataType="{x:Type pm:PackageSourceViewModel}">
							<TextBlock Text="{Binding Mode=OneWay, Path=Name}" />
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>
				<Button>Conf</Button>
			</StackPanel>
		</Grid>
	</DockPanel>
</UserControl>